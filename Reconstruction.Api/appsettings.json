{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Disasters": "Data Source=../DisasterLocation/App_Data/disasters.db"
  },
  "ExternalApis": {
    "Disasters": "http://localhost:5156/"
  },
  "Reconstruction": {
    "DemoExternalData": false
  },
  "Messaging": {
    "Enabled": true,
    "HostName": "localhost",
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "reconstruction.events",
    "TimelineQueue": "reconstruction.timeline",
    "Port": 5672,
    "VirtualHost": "/",
    "FormalizationQueue": "reconstruction.formalization",
    "MonitoringQueue": "reconstruction.monitoring",
    "ClosureQueue": "reconstruction.closure",
    "IntegrationsQueue": "reconstruction.integrations",
    "DeadLetterExchange": "reconstruction.events.dlx",
    "MaxDeliveryAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "PublishTimeoutSeconds": 15
  }
}
