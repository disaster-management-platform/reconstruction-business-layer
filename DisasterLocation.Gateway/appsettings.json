{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "reconstruction": {
        "ClusterId": "reconstruction-api",
        "Order": -10,
        "Match": {
          "Path": "/api/reconstruccion/{**remainder}"
        }
      },
      "disasters": {
        "ClusterId": "disasters-api",
        "Match": {
          "Path": "/api/{**remainder}"
        },
        "Order": 100
      }
    },
    "Clusters": {
      "disasters-api": {
        "Destinations": {
          "local": {
            "Address": "http://localhost:5156/"
          }
        }
      },
      "reconstruction-api": {
        "Destinations": {
          "local": {
            "Address": "http://localhost:5160/"
          }
        }
      }
    }
  }
}
